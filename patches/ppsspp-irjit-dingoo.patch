@@ -374,0 +375,37 @@ void Arm64JitBackend::CompIR_ValidateAddress(IRInst inst) {
+#ifdef DINGOO_PIE_DINGOO_MEMORY
+	if (regs_.IsGPRImm(inst.src1))
+		MOVI2R(SCRATCH1, regs_.GetGPRImm(inst.src1));
+	else if (regs_.IsGPRMapped(inst.src1))
+		MOV(SCRATCH1, regs_.R(inst.src1));
+	else
+		LDR(INDEX_UNSIGNED, SCRATCH1, CTXREG, regs_.GetIRRegOffset(inst.src1));
+	ADDI2R(SCRATCH1, SCRATCH1, inst.constant, SCRATCH2);
+	STR(INDEX_UNSIGNED, SCRATCH1, CTXREG, offsetof(MIPSState, temp));
+	regs_.FlushAll();
+	LDR(INDEX_UNSIGNED, SCRATCH1, CTXREG, offsetof(MIPSState, temp));
+
+	std::vector<FixupBranch> fallbackJumps;
+	if (alignment == 2)
+		fallbackJumps.push_back(TBNZ(SCRATCH1, 0));
+	else if (alignment != 1) {
+		TSTI2R(SCRATCH1, alignment - 1, SCRATCH2);
+		fallbackJumps.push_back(B(CC_NEQ));
+	}
+	LSR(SCRATCH2, SCRATCH1, 12);
+	LSL(SCRATCH2_64, SCRATCH2_64, 3);
+	LDR(SCRATCH2_64, MEMBASEREG, ArithOption(SCRATCH2_64));
+	fallbackJumps.push_back(CBZ(SCRATCH2_64));
