+	MOVI2R(W1, alignment);
+	MOVI2R(W2, isWrite ? 1 : 0);
+	SaveStaticRegisters();
+	QuickCallFunction(SCRATCH2_64, &ppssppShimValidateAddress);
+	LoadStaticRegisters();
+	CBNZ(W0, dispatcherCheckCoreState_);
+	SetJumpTarget(done);
+	return;
+#endif
