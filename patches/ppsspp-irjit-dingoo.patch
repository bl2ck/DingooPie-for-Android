+	MOV(32, MDisp(CTXREG, tempOffset), R(SCRATCH1));
+	FlushAll();
+	MOV(32, R(SCRATCH1), MDisp(CTXREG, tempOffset));
+	std::vector<FixupBranch> fallbackJumps;
+	if (alignment != 1) {
+		TEST(32, R(SCRATCH1), Imm32(alignment - 1));
